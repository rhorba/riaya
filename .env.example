# ── Database ────────────────────────────────────────────────────────────────
# App connection: non-superuser `riaya_app` role → RLS ENFORCED. Used by all feature code.
DATABASE_URL=postgresql://riaya_app:change-me-in-production@localhost:5439/riaya
# Privileged connection: superuser/owner → RLS BYPASSED. Migrations + Auth.js identity + system writes only.
DATABASE_URL_ADMIN=postgresql://riaya:riaya@localhost:5439/riaya

# ── Auth.js v5 ───────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# ── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@riaya.ma

# ── Cloudflare R2 (document storage) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=riaya-documents-private
R2_PUBLIC_URL=

# ── CMI Payment Gateway ───────────────────────────────────────────────────────
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_BASE_URL=https://testpayment.cmi.co.ma

# ── pg-boss worker ───────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
