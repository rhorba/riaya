{
  "name": "riaya",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @riaya/web dev",
    "build": "pnpm --filter @riaya/web build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @riaya/db db:generate",
    "db:migrate": "pnpm --filter @riaya/db db:migrate",
    "db:seed": "pnpm --filter @riaya/db db:seed",
    "db:embed": "pnpm --filter @riaya/matching db:embed",
    "db:setup": "pnpm db:migrate && pnpm db:seed && pnpm db:embed",
    "db:studio": "pnpm --filter @riaya/db db:studio",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
